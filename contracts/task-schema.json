{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidoretto.dev/schemas/skill-team/v3/task.schema.json",
  "title": "skill-team/v3 task fields",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "state",
    "executor",
    "reviewer",
    "dependencies",
    "write_scope",
    "forbidden_scope",
    "objective",
    "inputs",
    "outputs",
    "errors",
    "invariants",
    "security",
    "implementation_steps",
    "tests",
    "acceptance",
    "rollback",
    "evidence",
    "escalation"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-\\d{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "state": {
      "enum": ["PENDING", "IN_PROGRESS", "BLOCKED", "COMPLETE", "CANCELLED"]
    },
    "priority": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
    "risk": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
    "executor": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "requirement_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^REQ-\\d{3}$" }
    },
    "decision_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DEC-\\d{3}$" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-\\d{3}$" }
    },
    "write_scope": {
      "type": "object",
      "properties": {
        "files": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } }
      }
    },
    "forbidden_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "objective": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "errors": { "type": "array", "items": { "type": "string" } },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "security": { "type": "array", "items": { "type": "string" } },
    "implementation_steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rollback": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "escalation": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
