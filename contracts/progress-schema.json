{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidoretto.dev/schemas/skill-team/v3/progress.schema.json",
  "title": "skill-team/v3 PROGRESS.md frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_contract",
    "project_id",
    "project_slug",
    "workflow_profile",
    "stage",
    "status",
    "stage_owner",
    "required_skill",
    "successor_skill",
    "handoff_status",
    "discovery_revision",
    "plan_revision",
    "routing_revision",
    "implementation_revision",
    "review_revision",
    "release_revision",
    "active_artifact",
    "writer_skill",
    "next_action",
    "blockers",
    "last_validation_command",
    "last_validation_result",
    "updated_at"
  ],
  "properties": {
    "workflow_contract": { "const": "skill-team/v3" },
    "project_id": { "type": "string", "minLength": 1 },
    "project_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "workflow_profile": { "enum": ["compact", "standard", "critical"] },
    "stage": {
      "enum": ["DISCOVERY", "PLANNING", "ROUTING", "IMPLEMENTATION", "REVIEW", "RELEASE"]
    },
    "status": { "type": "string", "minLength": 1 },
    "stage_owner": { "type": "string", "minLength": 1 },
    "required_skill": { "type": "string", "minLength": 1 },
    "successor_skill": { "type": ["string", "null"] },
    "handoff_status": { "enum": ["NOT_READY", "READY", "CONSUMED"] },
    "discovery_revision": { "type": "integer", "minimum": 0 },
    "plan_revision": { "type": "integer", "minimum": 0 },
    "routing_revision": { "type": "integer", "minimum": 0 },
    "implementation_revision": { "type": "integer", "minimum": 0 },
    "review_revision": { "type": "integer", "minimum": 0 },
    "release_revision": { "type": "integer", "minimum": 0 },
    "active_artifact": { "type": ["string", "null"] },
    "active_task": { "type": ["string", "null"] },
    "active_batch": { "type": ["string", "null"] },
    "active_executor_model": { "type": ["string", "null"] },
    "active_reviewer_model": { "type": ["string", "null"] },
    "writer_skill": { "type": ["string", "null"] },
    "writer_task": { "type": ["string", "null"] },
    "next_action": { "type": "string" },
    "blockers": { "type": "string" },
    "last_validation_command": { "type": "string" },
    "last_validation_result": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
