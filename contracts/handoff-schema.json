{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidoretto.dev/schemas/skill-team/v3/handoff.schema.json",
  "title": "skill-team/v3 handoff frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_contract",
    "handoff_type",
    "project_id",
    "producer_skill",
    "consumer_skill",
    "input_revision",
    "output_revision",
    "handoff_status",
    "validation_command",
    "validation_result",
    "generated_at"
  ],
  "properties": {
    "workflow_contract": { "const": "skill-team/v3" },
    "handoff_type": {
      "enum": [
        "brainstorm-to-plan",
        "codebase-to-plan",
        "ux-audit-to-plan",
        "plan-to-routing",
        "routing-to-implementation",
        "implementation-to-review",
        "implementation-to-release",
        "review-to-implementation",
        "review-to-release"
      ]
    },
    "project_id": { "type": "string", "minLength": 1 },
    "producer_skill": { "type": "string", "minLength": 1 },
    "consumer_skill": { "type": "string", "minLength": 1 },
    "input_revision": { "type": "integer", "minimum": 0 },
    "output_revision": { "type": "integer", "minimum": 0 },
    "handoff_status": { "enum": ["NOT_READY", "READY", "CONSUMED"] },
    "validation_command": { "type": "string" },
    "validation_result": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
    "generated_at": { "type": "string", "minLength": 1 }
  }
}
